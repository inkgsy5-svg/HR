{
  "expo": {
    "name": "Haciéndolo Real",
    "slug": "hr-app",
    "version": "1.0.0",
    "scheme": "hracapp",
    "orientation": "portrait",
    "icon": "./assets/1-Home-HR.jpeg",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/1-Home-HR.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.haciendoloreal.hrapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/1-Home-HR.jpeg",
        "backgroundColor": "#111111"
      },
      "package": "com.haciendoloreal.hrapp",
      "edgeToEdgeEnabled": true,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "extra": {
      "apiUrl": "http://localhost:3000",
      "googleAuth": {
        "iosClientId": "YOUR_IOS_CLIENT_ID.apps.googleusercontent.com",
        "androidClientId": "YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com",
        "webClientId": "YOUR_WEB_CLIENT_ID.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "d7c15959-2398-4e36-95e3-b8265708e2a4"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos tus fotos para poner tu foto de perfil.",
          "cameraPermission": "Usamos la cámara para tomar tu foto de perfil."
        }
      ],
      "@sentry/react-native",
      "expo-font"
    ],
    "owner": "caye_micky"
  }
}
